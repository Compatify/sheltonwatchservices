---
interface Props {
  category: string;
  title: string;
  excerpt: string;
  href: string;
}

const { category, title, excerpt, href } = Astro.props;
---

<article class="guide-card">
  <p class="guide-card-cat">{category}</p>
  <h3 class="guide-card-title">{title}</h3>
  <p class="muted guide-card-excerpt">{excerpt}</p>
  <a class="text-link" href={href}>Read article →</a>
</article>

<style>
  .guide-card {
    background: var(--ivory2);
    padding: 26px 22px;
    border: 0.5px solid var(--rule-lt);
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .guide-card:hover {
    background: var(--ivory3);
    border-top: 2px solid var(--gold);
    border-left: 0.5px solid var(--rule-lt);
    border-right: 0.5px solid var(--rule-lt);
    border-bottom: 0.5px solid var(--rule-lt);
  }

  .guide-card-cat {
    font-size: 9px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 12px;
  }

  .guide-card-title {
    margin-bottom: 10px;
  }

  .guide-card-excerpt {
    margin-bottom: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
