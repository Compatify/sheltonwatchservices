---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  category: string;
  title: string;
  excerpt: string;
  href: string;
  coverPhoto: ImageMetadata;
}

const { category, title, excerpt, href, coverPhoto } = Astro.props;
---

<article class="guide-card">
  <a class="guide-card-link" href={href}>
    <div class="guide-card-cover">
      <Image
        src={coverPhoto}
        alt=""
        width={640}
        height={360}
        class="guide-card-cover-img"
      />
    </div>
    <div class="guide-card-body">
      <p class="guide-card-cat">{category}</p>
      <h3 class="guide-card-title">{title}</h3>
      <p class="muted guide-card-excerpt">{excerpt}</p>
      <span class="text-link">Read article →</span>
    </div>
  </a>
</article>

<style>
  .guide-card {
    background: var(--ivory2);
    border: 0.5px solid var(--rule-lt);
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
    overflow: hidden;
    padding: 0;
  }

  .guide-card:hover {
    background: var(--ivory3);
    border-top: 2px solid var(--gold);
    border-left: 0.5px solid var(--rule-lt);
    border-right: 0.5px solid var(--rule-lt);
    border-bottom: 0.5px solid var(--rule-lt);
  }

  .guide-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .guide-card-cover {
    height: 180px;
    width: 100%;
    overflow: hidden;
  }

  .guide-card-cover :global(.guide-card-cover-img),
  .guide-card-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .guide-card-body {
    padding: 22px 22px 26px;
  }

  .guide-card-cat {
    font-family: var(--sans);
    font-size: 9px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 12px;
  }

  .guide-card-title {
    margin-bottom: 10px;
  }

  .guide-card-excerpt {
    margin-bottom: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
