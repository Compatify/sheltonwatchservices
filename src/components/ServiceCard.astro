---
interface Props {
  num: string;
  title: string;
  description: string;
  price: string;
  tags: string[];
}

const { num, title, description, price, tags } = Astro.props;
---

<article class="service-card">
  <p class="service-card-num">{num}</p>
  <h3>{title}</h3>
  <p class="muted stack-sm">{description}</p>
  <p class="price service-card-price">{price}</p>
  <div class="service-card-tags">
    {tags.map((t) => <span class="badge">{t}</span>)}
  </div>
</article>

<style>
  .service-card {
    background: var(--ivory);
    padding: 28px 24px;
    border: 0.5px solid var(--rule-lt);
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .service-card:hover {
    background: var(--ivory3);
    border-top: 2px solid var(--gold);
    border-left: 0.5px solid var(--rule-lt);
    border-right: 0.5px solid var(--rule-lt);
    border-bottom: 0.5px solid var(--rule-lt);
  }

  .service-card-num {
    font-family: var(--sans);
    font-size: 42px;
    font-weight: 300;
    color: var(--ink4);
    line-height: 1;
    margin-bottom: 12px;
  }

  .service-card h3 {
    margin-bottom: 10px;
  }

  .service-card-price {
    font-style: italic;
    margin: 14px 0 12px;
  }

  .service-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
