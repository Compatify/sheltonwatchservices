<div class="announcement-bar" role="region" aria-label="Site announcement">
  <div class="announcement-bar-inner">
    <p class="announcement-bar-text">
      Join the list — no spam, just deals, new arrivals, and watch tips.
      <a href="/contact/" class="announcement-bar-link">Sign up free →</a>
    </p>
    <button type="button" class="announcement-bar-close" aria-label="Dismiss announcement">
      <span aria-hidden="true">×</span>
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var key = 'sws-announcement-dismissed';
    var btn = document.querySelector('.announcement-bar-close');
    if (!btn) return;
    btn.addEventListener('click', function () {
      try {
        localStorage.setItem(key, '1');
      } catch (e) {}
      document.documentElement.classList.add('announcement-dismissed');
    });
  })();
</script>

<style>
  .announcement-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 101;
    height: var(--announcement-h);
    overflow: hidden;
    background: color-mix(in srgb, var(--gold) 78%, var(--forest) 22%);
    border-bottom: 1px solid color-mix(in srgb, var(--forest) 25%, transparent);
    transition: height 0.22s ease, opacity 0.22s ease, border-color 0.22s ease;
  }

  :global(html.announcement-dismissed) .announcement-bar {
    opacity: 0;
    pointer-events: none;
    border-bottom-color: transparent;
  }

  .announcement-bar-inner {
    position: relative;
    box-sizing: border-box;
    max-width: 1180px;
    height: 40px;
    margin: 0 auto;
    padding: 0 clamp(40px, 5vw, 52px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .announcement-bar-text {
    margin: 0;
    font-family: var(--sans);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.055em;
    line-height: 1.25;
    color: var(--forest);
    text-align: center;
  }

  @media (max-width: 520px) {
    .announcement-bar-text {
      font-size: 11px;
      letter-spacing: 0.04em;
    }
  }

  .announcement-bar-link {
    margin-left: 0.35em;
    color: var(--forest);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .announcement-bar-link:hover {
    color: var(--forest2);
  }

  .announcement-bar-close {
    position: absolute;
    top: 50%;
    right: clamp(6px, 2vw, 14px);
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    padding: 0;
    border: none;
    background: transparent;
    font-family: var(--sans);
    font-size: 22px;
    line-height: 1;
    font-weight: 400;
    color: var(--forest);
    opacity: 0.72;
    cursor: pointer;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s ease, background-color 0.15s ease;
  }

  .announcement-bar-close:hover {
    opacity: 1;
    background-color: color-mix(in srgb, var(--forest) 12%, transparent);
  }

  .announcement-bar-close:focus-visible {
    outline: 2px solid var(--forest);
    outline-offset: 2px;
  }
</style>
