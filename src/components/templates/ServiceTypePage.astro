---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteChrome from '../SiteChrome.astro';
import ServiceRequestForm from '../ServiceRequestForm.astro';
import { serviceSchema } from '../../utils/serviceSchema';
import { faqPageSchema } from '../../utils/faqSchema';
import { jsonLd } from '../../utils/schema';

interface Props {
  title: string;
  description: string;
  h1: string;
  serviceType: string;
  serviceDescription: string;
  answer: string;
  faqs: { q: string; a: string }[];
  formSuffix: string;
}

const { title, description, h1, serviceType, serviceDescription, answer, faqs, formSuffix } = Astro.props;

const svc = serviceSchema(serviceType, serviceDescription);
const faqLd = faqPageSchema(faqs);
---

<BaseLayout {title} {description}>
  <script type="application/ld+json" slot="head" set:html={jsonLd(svc)} />
  <script type="application/ld+json" slot="head" set:html={jsonLd(faqLd)} />
  <SiteChrome>
    <main id="main">
      <article class="section section--ivory">
        <div class="container prose">
          <h1>{h1}</h1>
          <div class="answer-capsule">
            <p>{answer}</p>
          </div>
          <slot />
          <h2>Request this service</h2>
          <ServiceRequestForm idSuffix={formSuffix} />
          <h2>Frequently Asked Questions</h2>
          <dl class="faq-list">
            {faqs.map((f) => (
              <>
                <dt>{f.q}</dt>
                <dd>{f.a}</dd>
              </>
            ))}
          </dl>
        </div>
      </article>
    </main>
  </SiteChrome>
</BaseLayout>

<style>
  .prose h2 {
    font-family: var(--serif);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 300;
    margin: 32px 0 14px;
  }

  .prose :global(p) {
    color: var(--ink3);
    margin-bottom: 14px;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0 8px;
    font-size: 14px;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 0.5px solid var(--rule);
    padding: 10px 12px;
    text-align: left;
  }

  .prose :global(th) {
    color: var(--ink2);
    font-weight: 500;
  }

  .prose :global(.cross a) {
    color: var(--ink3);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(.cross a:hover) {
    color: var(--gold);
  }

  .faq-list dt {
    font-weight: 500;
    margin-top: 18px;
    color: var(--ink2);
  }

  .faq-list dd {
    margin: 8px 0 0;
    color: var(--ink3);
  }
</style>
