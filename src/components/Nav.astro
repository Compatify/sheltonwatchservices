---
const pathname = Astro.url.pathname;
const links = [
  { href: '/shop/', label: 'Shop' },
  { href: '/service/', label: 'Service' },
  { href: '/sell/', label: 'Sell' },
  { href: '/tools/', label: 'Tools' },
  { href: '/guide/', label: 'Journal' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/' || pathname === '';
  if (pathname === href) return true;
  if (href.endsWith('/') && pathname.startsWith(href)) return true;
  return false;
}
---

<nav class="site-nav" aria-label="Primary">
  <div class="nav-inner">
    <a class="nav-logo" href="/">
      <!-- OWNER: If logo still appears small, the PNG may have excess transparent padding — crop it tighter in Preview or Photoshop -->
      <img
        src="/SWS-logo.svg"
        alt="Shelton Watch Services"
        class="logo-img"
        loading="eager"
      />
    </a>
    <ul class="nav-links">
      {
        links.map((l) => (
          <li>
            <a class:list={['nav-link', { active: isActive(l.href) }]} href={l.href}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn-secondary nav-cta" href="/contact/">Get in Touch</a>
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-panel" aria-label="Open menu">
      &#9776;
    </button>
  </div>
  <div id="nav-panel" class="nav-panel" hidden>
    <ul class="nav-panel-list">
      {
        links.map((l) => (
          <li>
            <a class:list={['nav-panel-link', { active: isActive(l.href) }]} href={l.href}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="btn-secondary nav-panel-cta" href="/book/">Book</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: var(--announcement-h);
    left: 0;
    width: 100%;
    z-index: 100;
    background: #fff;
    border-bottom: 1px solid var(--rule-lt);
    box-shadow: 0 1px 0 rgba(30, 51, 40, 0.04);
    transition: top 0.22s ease;
  }

  .nav-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 48px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .nav-logo {
    display: flex;
    align-items: center;
  }

  .logo-img {
    height: 64px;
    width: auto;
  }

  .nav-links {
    list-style: none;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 40px;
  }

  .nav-link {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(30, 51, 40, 0.82);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--forest);
  }

  .nav-cta {
    flex-shrink: 0;
  }

  .site-nav .nav-cta.btn-secondary,
  .site-nav .nav-panel-cta.btn-secondary {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    padding: 11px 20px;
    color: var(--forest);
    border-color: rgba(30, 51, 40, 0.32);
  }

  .site-nav .nav-cta.btn-secondary:hover,
  .site-nav .nav-panel-cta.btn-secondary:hover {
    color: var(--forest);
    border-color: var(--forest2);
    background: rgba(30, 51, 40, 0.06);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: rgba(30, 51, 40, 0.78);
    font-size: 22px;
    cursor: pointer;
    padding: 8px;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .nav-toggle:hover {
    color: var(--forest);
  }

  .nav-panel {
    background: #fff;
    border-bottom: 1px solid var(--rule-lt);
  }

  .nav-panel-list {
    list-style: none;
    padding: 24px 48px 32px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .nav-panel-link {
    display: block;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(30, 51, 40, 0.82);
    text-decoration: none;
    padding: 10px 0;
    transition: color 0.2s;
  }

  .nav-panel-link:hover,
  .nav-panel-link.active {
    color: var(--forest);
  }

  .nav-panel-cta {
    margin-top: 16px;
    display: inline-block;
  }

  @media (max-width: 1179px) {
    .nav-inner {
      padding: 0 32px;
    }

    .nav-panel-list {
      padding: 24px 32px 32px;
    }
  }

  @media (max-width: 960px) {
    .nav-inner {
      padding: 0 24px;
    }

    .nav-links,
    .nav-cta {
      display: none;
    }

    .nav-toggle {
      display: block;
    }

    .nav-panel-list {
      padding: 24px 24px 32px;
    }
  }

  @media (max-width: 480px) {
    .nav-inner {
      padding: 0 16px;
    }

    .nav-panel-list {
      padding: 24px 16px 32px;
    }
  }

  @media (min-width: 961px) {
    .nav-panel {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.querySelector('.nav-toggle');
    var panel = document.getElementById('nav-panel');
    if (!btn || !panel) return;

    function setOpen(open) {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.hidden = !open;
    }

    btn.addEventListener('click', function () {
      var open = btn.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
