---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class:list={['watch-face-svg', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 120 120"
  width="120"
  height="120"
  aria-hidden="true"
>
  <circle cx="60" cy="60" r="54" fill="none" stroke="var(--ink4)" stroke-width="0.75" opacity="0.45" />
  <circle cx="60" cy="60" r="48" fill="var(--ivory3)" stroke="var(--forest3)" stroke-width="0.5" opacity="0.35" />
  <line x1="60" y1="18" x2="60" y2="26" stroke="var(--forest2)" stroke-width="0.75" opacity="0.5" />
  <line x1="60" y1="94" x2="60" y2="102" stroke="var(--forest2)" stroke-width="0.75" opacity="0.5" />
  <line x1="18" y1="60" x2="26" y2="60" stroke="var(--forest2)" stroke-width="0.75" opacity="0.5" />
  <line x1="94" y1="60" x2="102" y2="60" stroke="var(--forest2)" stroke-width="0.75" opacity="0.5" />
  <line x1="60" y1="60" x2="60" y2="34" stroke="var(--ink3)" stroke-width="1.2" stroke-linecap="round" opacity="0.55" />
  <line x1="60" y1="60" x2="78" y2="68" stroke="var(--ink4)" stroke-width="0.9" stroke-linecap="round" opacity="0.5" />
  <circle cx="60" cy="60" r="3" fill="var(--gold)" opacity="0.35" />
</svg>

<style>
  .watch-face-svg {
    display: block;
    margin: 0 auto 12px;
  }
</style>
