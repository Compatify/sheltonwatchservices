---
import { Image } from 'astro:assets';
import logo from '../assets/SWS-logo.PNG';
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-col">
      <a class="footer-logo" href="/">
        <Image
          class="logo-img"
          src={logo}
          alt="Shelton Watch Services"
          width={220}
          height={48}
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="footer-tagline">
        <em>Every timepiece tells a story. We make sure it keeps telling it.</em>
      </p>
    </div>
    <div class="footer-col">
      <h2 class="footer-heading">Services</h2>
      <ul class="footer-list">
        <li><a href="/service/">Watch Repair</a></li>
        <li><a href="/service/rolex/">Rolex Service</a></li>
        <li><a href="/service/omega/">Omega Service</a></li>
        <li><a href="/service/battery-replacement/">Battery Replacement</a></li>
        <li><a href="/service/full-overhaul/">Full Overhaul</a></li>
        <li><a href="/service/watch-appraisal/">Watch Appraisal</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h2 class="footer-heading">Buy &amp; Sell</h2>
      <ul class="footer-list">
        <li><a href="/shop/">Shop Watches</a></li>
        <li><a href="/sell/">Sell Your Watch</a></li>
        <li><a href="/sell/rolex/">Sell Your Rolex</a></li>
        <li><a href="/cash-for-watches/">Cash for Watches</a></li>
        <li><a href="/sell/#consignment">Consignment</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h2 class="footer-heading">Connect</h2>
      <ul class="footer-list">
        <li><a href="[OWNER: ADD YOUR INSTAGRAM URL]">Instagram</a></li>
        <li><a href="[OWNER: ADD YOUR YOUTUBE URL]">YouTube</a></li>
        <li><a href="[OWNER: ADD YOUR GOOGLE BUSINESS PROFILE REVIEW URL]">Google Reviews</a></li>
        <li><a href="https://www.watchuseek.com/">WatchUSeek</a></li>
        <li><a href="https://www.reddit.com/r/Watches">Reddit r/Watches</a></li>
        <li><a href="/sitemap/">HTML sitemap</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bar container">
    <p class="footer-copy">© 2026 Shelton Watch Services · Bethlehem, PA</p>
    <p class="footer-note"><em>Serving the Lehigh Valley since 2012</em></p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--forest);
    color: rgba(250, 247, 242, 0.88);
    padding: 72px 0 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
    gap: 48px 32px;
    padding-bottom: 56px;
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }

  .footer-tagline {
    font-family: var(--serif);
    font-size: 14px;
    color: rgba(250, 247, 242, 0.35);
    margin-top: 16px;
    max-width: 280px;
    line-height: 1.6;
  }

  .footer-heading {
    font-family: var(--sans);
    font-size: 9.5px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(197, 160, 40, 0.85);
    margin-bottom: 18px;
    font-weight: 400;
  }

  .footer-list {
    list-style: none;
  }

  .footer-list li {
    margin-bottom: 10px;
  }

  .footer-list a {
    color: rgba(250, 247, 242, 0.45);
    font-size: 13px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-list a:hover {
    color: var(--gold);
  }

  .footer-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 22px 48px 28px;
  }

  @media (max-width: 768px) {
    .footer-bar {
      padding: 22px 24px 28px;
    }
  }

  .footer-copy {
    font-size: 12.5px;
    color: rgba(250, 247, 242, 0.4);
  }

  .footer-note {
    font-size: 12.5px;
    color: rgba(250, 247, 242, 0.35);
  }
</style>
