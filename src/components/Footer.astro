---
// Footer.astro — no imports needed
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-container">
      <div class="footer-grid">
        <div class="footer-brand-col">
          <img
            src="/SWS-logo.svg"
            alt="Shelton Watch Services"
            class="footer-logo"
            width="200"
            height="45"
            loading="lazy"
          />
          <p class="footer-tagline">
            "Every timepiece tells a story.<br />We make sure it keeps telling it."
          </p>
          <div class="footer-contacts">
            <div class="footer-contact-item">
              <span class="footer-contact-label">Location</span>
              <span class="footer-contact-val">By appointment — Bethlehem, PA 18017</span>
            </div>
            <div class="footer-contact-item">
              <span class="footer-contact-label">Phone</span>
              <a href="tel:+14842914029" class="footer-contact-val">(484) 291-4029</a>
            </div>
            <div class="footer-contact-item">
              <span class="footer-contact-label">Email</span>
              <a href="mailto:info@sheltonwatchservices.com" class="footer-contact-val"
                >info@sheltonwatchservices.com</a
              >
            </div>
            <div class="footer-contact-item">
              <span class="footer-contact-label">Hours</span>
              <span class="footer-contact-val"
                >Available by appointment; reach out anytime, response within 24 hours</span
              >
            </div>
          </div>
          <div class="footer-social">
            <a href="#" class="social-icon" aria-label="Instagram">IG</a>
            <a href="#" class="social-icon" aria-label="YouTube">YT</a>
            <a href="#" class="social-icon" aria-label="Google Reviews">G★</a>
          </div>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Services</h4>
          <ul class="footer-links">
            <li><a href="/service/">Watch Repair & Service</a></li>
            <li><a href="/service/rolex/">Rolex Service</a></li>
            <li><a href="/service/omega/">Omega Service</a></li>
            <li><a href="/service/seiko/">Seiko Service</a></li>
            <li><a href="/service/battery-replacement/">Battery Replacement</a></li>
            <li><a href="/service/full-overhaul/">Full Overhaul</a></li>
            <li><a href="/service/vintage-restoration/">Vintage Restoration</a></li>
            <li><a href="/service/watch-appraisal/">Watch Appraisal</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Buy & Sell</h4>
          <ul class="footer-links">
            <li><a href="/shop/">Shop Pre-Owned Watches</a></li>
            <li><a href="/shop/rolex/">Rolex For Sale</a></li>
            <li><a href="/shop/omega/">Omega For Sale</a></li>
            <li><a href="/sell/">Sell Your Watch</a></li>
            <li><a href="/sell/rolex/">Sell Your Rolex</a></li>
            <li><a href="/cash-for-watches/">Cash for Watches</a></li>
            <li><a href="/sell-my-watch-today/">Sell My Watch Today</a></li>
            <li><a href="/pre-owned-watches-for-sale/">Pre-Owned Watches</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Learn & Connect</h4>
          <ul class="footer-links">
            <li><a href="/guide/">The Watch Journal</a></li>
            <li><a href="/tools/">Free Watch Tools</a></li>
            <li><a href="/tools/repair-or-sell/">Repair or Sell?</a></li>
            <li><a href="/about/">About Us</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/contact/">Book Appointment</a></li>
            <li><a href="/sitemap/">Sitemap</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-container">
      <div class="footer-bottom-inner">
        <div class="footer-legal">
          <a href="/sitemap/">Sitemap</a>
          <a href="/contact/">Contact</a>
          <a href="/about/">About</a>
        </div>
        <div class="footer-copy">© 2026 Shelton Watch Services · Bethlehem, PA</div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--forest);
  }
  .footer-top {
    padding: 64px 0 48px;
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.07);
  }
  .footer-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 48px;
  }
  @media (max-width: 768px) {
    .footer-container {
      padding: 0 24px;
    }
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 48px;
  }
  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
  .footer-logo {
    height: 48px;
    width: auto;
    filter: brightness(0) invert(1) sepia(0.32) saturate(0.38) brightness(0.78);
    opacity: 0.58;
    margin-bottom: 16px;
    display: block;
  }
  .footer-tagline {
    font-family: var(--ui);
    font-weight: 400;
    font-style: italic;
    font-size: 12.5px;
    line-height: 1.7;
    color: rgba(245, 240, 232, 0.52);
    margin-bottom: 24px;
    max-width: 220px;
  }
  .footer-contacts {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 22px;
  }
  .footer-contact-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .footer-contact-label {
    font-family: var(--ui);
    font-weight: 400;
    font-size: 7.5px;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .footer-contact-val {
    font-family: var(--ui);
    font-weight: 400;
    font-size: 12px;
    color: rgba(245, 240, 232, 0.65);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-contact-val:hover {
    color: rgba(245, 240, 232, 0.88);
  }
  .footer-social {
    display: flex;
    gap: 8px;
  }
  .social-icon {
    width: 34px;
    height: 34px;
    border: 0.5px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ui);
    font-weight: 400;
    font-size: 8.5px;
    color: rgba(245, 240, 232, 0.55);
    text-decoration: none;
    transition: all 0.2s;
  }
  .social-icon:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .footer-col-title {
    font-family: var(--ui);
    font-weight: 600;
    font-size: 9.5px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.65);
    margin-bottom: 18px;
  }
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 0;
    padding: 0;
  }
  .footer-links a {
    font-family: var(--ui);
    font-weight: 400;
    font-size: 12.5px;
    color: rgba(245, 240, 232, 0.58);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-links a:hover {
    color: var(--gold);
  }
  .footer-bottom {
    padding: 18px 0;
  }
  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer-legal {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  .footer-legal a {
    font-family: var(--ui);
    font-weight: 400;
    font-size: 10.5px;
    letter-spacing: 0.07em;
    color: rgba(245, 240, 232, 0.42);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-legal a:hover {
    color: rgba(245, 240, 232, 0.62);
  }
  .footer-copy {
    font-family: var(--ui);
    font-weight: 400;
    font-size: 10.5px;
    letter-spacing: 0.07em;
    color: rgba(245, 240, 232, 0.42);
  }
</style>
