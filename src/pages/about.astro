---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteChrome from '../components/SiteChrome.astro';
import TrustBar from '../components/TrustBar.astro';
import aboutImg from '../assets/watches/photo-1593019079637-ac824a5e6330.jpeg';
import { localBusinessSchema } from '../data/schema/localBusiness';
import { jsonLd } from '../utils/schema';
---

<BaseLayout
  title="About Shelton Watch Services | Bethlehem PA Watchmaker"
  description="Meet the watchmaker behind Shelton Watch Services. 12+ years servicing fine timepieces in the Lehigh Valley. Personal, expert, transparent."
>
  <script type="application/ld+json" slot="head" set:html={jsonLd(localBusinessSchema)} />
  <SiteChrome>
    <main id="main">
      <article class="section section--ivory">
        <div class="container about-page">
          <h1>About Shelton Watch Services</h1>
          <p class="pull-quote">
            <em>I've been opening watches since before most people knew what a movement was.</em>
          </p>
          <div class="about-grid">
            <div class="about-photo">
              <Image
                src={aboutImg}
                alt="Watchmaker at work — Shelton Watch Services"
                width={900}
                height={700}
                class="about-photo-img"
              />
            </div>
            <div class="about-copy muted">
              <p>
                Pierson Shelton has been working on watches in the Lehigh Valley for over 12 years. What
                started as a hobby restoring vintage pieces became a full-time trade — buying, selling,
                and servicing timepieces for collectors and everyday wearers alike.
              </p>
              <p>Every watch that comes through gets treated like it matters. Because to someone, it does.</p>
              <p>Based in Bethlehem, PA. Available by appointment. Mail-in service nationwide.</p>
            </div>
          </div>
          <section class="credentials">
            <h2>Brands worked on</h2>
            <p class="muted">
              Rolex, Omega, Seiko, Tudor, Cartier, TAG Heuer, Hamilton, Longines, vintage American pieces,
              and many more — including pocket watches that deserve patient, informed work.
            </p>
          </section>
        </div>
      </article>
      <TrustBar variant="ivory" />
      <section class="section section--ivory2">
        <div class="container">
          <p class="pull-quote">
            <em>By appointment in Bethlehem, PA — mail-in service nationwide.</em>
          </p>
          <div class="about-cta">
            <a class="btn-primary" href="/service/">Book a Service</a>
            <a class="btn-ghost" href="/shop/">See Available Watches</a>
          </div>
        </div>
      </section>
    </main>
  </SiteChrome>
</BaseLayout>

<style>
  .about-page h1 {
    margin-bottom: 24px;
  }

  .pull-quote {
    font-family: var(--sans);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 400;
    line-height: 1.35;
    color: var(--ink2);
    margin-bottom: 36px;
    max-width: 720px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 40px;
    align-items: start;
    margin-bottom: 48px;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .about-photo {
    min-height: 280px;
    border: 0.5px solid var(--rule-lt);
    overflow: hidden;
  }

  .about-photo :global(.about-photo-img),
  .about-photo :global(img) {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .about-copy p + p {
    margin-top: 16px;
  }

  .credentials h2 {
    font-family: var(--sans);
    font-size: 28px;
    font-weight: 400;
    margin-bottom: 14px;
  }

  .credentials p + p {
    margin-top: 12px;
  }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
</style>
