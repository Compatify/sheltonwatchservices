---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteChrome from '../components/SiteChrome.astro';
import TrustBar from '../components/TrustBar.astro';
import { localBusinessSchema } from '../data/schema/localBusiness';
import { jsonLd } from '../utils/schema';
---

<BaseLayout
  title="About Shelton Watch Services | Bethlehem PA Watchmaker"
  description="Meet the watchmaker behind Shelton Watch Services. 12+ years servicing fine timepieces in the Lehigh Valley. Personal, expert, transparent."
>
  <script type="application/ld+json" slot="head" set:html={jsonLd(localBusinessSchema)} />
  <SiteChrome>
    <main id="main">
      <article class="section section--ivory">
        <div class="container about-page">
          <h1>About Shelton Watch Services</h1>
          <p class="pull-quote">
            <em>I've been opening watches since before most people knew what a movement was.</em>
          </p>
          <div class="about-grid">
            <div class="photo-placeholder">
              <p>
                Your photo here — at your bench, warm natural light<br />
                <span class="muted">[OWNER: Replace with portrait or workshop photo]</span>
              </p>
            </div>
            <div class="about-copy muted">
              <p>
                [OWNER BIO — Write in first person. Cover: how you got into watchmaking, how long you've
                been doing it (12+ years), what the Lehigh Valley means to you, what makes SWS different
                from chain jewelry stores and sending watches away to unknown service centers, your
                philosophy on transparency and pricing. 3–4 paragraphs.]
              </p>
            </div>
          </div>
          <section class="credentials">
            <h2>Brands &amp; credentials</h2>
            <p class="muted">
              Rolex, Omega, Seiko, Tudor, Cartier, TAG Heuer, Hamilton, Longines, vintage American pieces,
              and many more — including pocket watches that deserve patient, informed work.
            </p>
            <p class="muted">
              <strong>Training &amp; certifications:</strong> [OWNER: Add your actual credentials]
            </p>
            <p class="muted">
              <strong>Equipment:</strong> [OWNER: Add your equipment — timegrapher, ultrasonic cleaner,
              etc.]
            </p>
          </section>
        </div>
      </article>
      <TrustBar variant="ivory" />
      <section class="section section--ivory2">
        <div class="container">
          <p class="pull-quote">
            <em>[OWNER: Add your favorite quote about watchmaking or your approach]</em>
          </p>
          <div class="about-cta">
            <a class="btn-primary" href="/service/">Book a Service</a>
            <a class="btn-ghost" href="/shop/">See Available Watches</a>
          </div>
        </div>
      </section>
    </main>
  </SiteChrome>
</BaseLayout>

<style>
  .about-page h1 {
    margin-bottom: 24px;
  }

  .pull-quote {
    font-family: var(--serif);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 300;
    line-height: 1.35;
    color: var(--ink2);
    margin-bottom: 36px;
    max-width: 720px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 40px;
    align-items: start;
    margin-bottom: 48px;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .photo-placeholder {
    min-height: 280px;
    background: var(--ivory3);
    border: 0.5px solid var(--rule-lt);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
    font-size: 14px;
    line-height: 1.65;
  }

  .about-copy p + p {
    margin-top: 16px;
  }

  .credentials h2 {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 300;
    margin-bottom: 14px;
  }

  .credentials p + p {
    margin-top: 12px;
  }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
</style>
