---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import InquiryModal from '../components/InquiryModal.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { watches, watchDetailPath } from '../data/watches';
import { localBusinessSchema } from '../data/schema/localBusiness';
import { jsonLd } from '../utils/schema';
import { productSchemaForWatch } from '../utils/productSchema';

import heroBg from '../assets/watches/photo-1702865053708-be5f974d5e05.jpeg';
import photoRolex from '../assets/watches/photo-1610006329898-2a4f12019450.jpeg';
import photoOmega from '../assets/watches/photo-1773755060442-6d128b70dd20.jpeg';
import photoTudor from '../assets/watches/photo-1767009951352-a271b6155eeb.jpeg';
import photoIWC from '../assets/watches/premium_photo-1723561230205-3a8f566f8ba9.jpeg';
import photoLongines from '../assets/watches/hunters-race-MQwdj_ZyJAk-unsplash.jpeg';
import photoSeiko from '../assets/watches/premium_photo-1728249572934-f56a637a92a4.jpeg';

import journalPhoto1 from '../assets/watches/photo-1767009951352-a271b6155eeb.jpeg';
import journalPhoto2 from '../assets/watches/premium_photo-1682097578070-901d10cabc5b.jpeg';
import journalPhoto3 from '../assets/watches/photo-1606744188285-d0a49e58f538.jpeg';

const watchPhotos: Record<string, ImageMetadata> = {
  'rolex-datejust-41-126334': photoRolex,
  'omega-seamaster-300m': photoOmega,
  'tudor-black-bay-58-navy': photoTudor,
  'iwc-portofino-iw356504': photoIWC,
  'longines-master-collection-40': photoLongines,
  'seiko-sarb033-cocktail-time': photoSeiko,
};

const pageTitle = 'Shelton Watch Services | Buy, Sell & Service Fine Watches | Lehigh Valley PA';
const pageDescription =
  'Expert watch repair, buying, and selling in the Lehigh Valley. Transparent pricing, 12+ years experience. Rolex, Omega, Seiko, vintage and more. Bethlehem PA.';

const productGraph = { '@context': 'https://schema.org', '@graph': watches.map(productSchemaForWatch) };
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" slot="head" set:html={jsonLd(localBusinessSchema)} />
  <script type="application/ld+json" slot="head" set:html={jsonLd(productGraph)} />

  <Nav />

  <main id="main">
    <section class="hero">
      <div class="hero-overlay"></div>
      <div class="hero-photo-col">
        <Image
          src={heroBg}
          alt="Watchmaker at work in the Lehigh Valley"
          class="hero-img"
          loading="eager"
          width={1600}
          height={1067}
          widths={[800, 1200, 1600]}
          sizes="45vw"
        />
        <div class="hero-photo-gradient"></div>
      </div>
      <div class="hero-content">
        <p class="eyebrow-hero">Bethlehem, Pennsylvania</p>
        <h1 class="hero-h1">
          Watchmaker.<br />Collector.<br /><em>Your guy<br />in the Valley.</em>
        </h1>
        <p class="hero-sub">
          12 years servicing and buying fine timepieces across the Lehigh Valley. Expert repair, transparent
          pricing, personal service.
        </p>
        <div class="hero-btns">
          <a href="/shop/" class="btn-primary">Browse Watches</a>
          <a href="/contact/" class="btn-ghost-light">Book a Service</a>
        </div>
      </div>
    </section>

    <section class="section-watches">
      <div class="container">
        <div class="section-hd">
          <h2 class="section-title">Available Now</h2>
          <a href="/shop/" class="section-link">View all watches →</a>
        </div>
        <div class="watch-grid">
          {
            watches.map((watch) => (
              <a href={watchDetailPath(watch.slug)} class="watch-card">
                <div class="watch-card-img">
                  {watchPhotos[watch.slug] && (
                    <Image
                      src={watchPhotos[watch.slug]}
                      alt={`${watch.brand} ${watch.model}`}
                      class="watch-photo"
                      width={400}
                      height={280}
                      loading="lazy"
                    />
                  )}
                  <span class="watch-badge">Available</span>
                </div>
                <div class="watch-card-info">
                  <div class="watch-brand">{watch.brand}</div>
                  <div class="watch-model">{watch.model}</div>
                  <div class="watch-ref">{watch.reference}</div>
                  <div class="watch-card-footer">
                    <div class="watch-price">{watch.priceDisplay}</div>
                    <div class="watch-cond">{watch.condition}</div>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-service">
      <div class="container">
        <div class="section-hd-light">
          <h2 class="section-title-light">Watch Service & Repair</h2>
          <a href="/service/" class="section-link-light">All services →</a>
        </div>
        <div class="service-grid">
          <div class="service-card">
            <div class="service-num">01</div>
            <h3 class="service-name">Battery & Quartz Care</h3>
            <p class="service-desc">
              Correct cell selection, pressure-tested resealing, coil inspection for running issues.
            </p>
            <div class="service-price">From $25</div>
            <div class="service-tags">
              <span>Same week</span>
              <span>While you wait</span>
            </div>
          </div>
          <div class="service-card">
            <div class="service-num">02</div>
            <h3 class="service-name">Crystal & Case Work</h3>
            <p class="service-desc">Sapphire and acrylic replacements, bezel alignment, careful refinishing.</p>
            <div class="service-price">From $80</div>
            <div class="service-tags">
              <span>OEM parts</span>
              <span>Detail-first</span>
            </div>
          </div>
          <div class="service-card">
            <div class="service-num">03</div>
            <h3 class="service-name">Full Mechanical Service</h3>
            <p class="service-desc">
              Disassembly, ultrasonic cleaning, lubrication, regulation, documented report.
            </p>
            <div class="service-price">From $250</div>
            <div class="service-tags">
              <span>Timegrapher</span>
              <span>Written report</span>
            </div>
          </div>
          <div class="service-card">
            <div class="service-num">04</div>
            <h3 class="service-name">Vintage Restoration</h3>
            <p class="service-desc">
              Pocket watches to mid-century pieces — conservative approach with collector judgment.
            </p>
            <div class="service-price">From $350+</div>
            <div class="service-tags">
              <span>Pocket watches</span>
              <span>Heritage pieces</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-sell">
      <div class="container">
        <div class="sell-grid">
          <div class="sell-left">
            <p class="eyebrow-light">Get an Offer</p>
            <h2 class="sell-h2">Sell Your Timepiece</h2>
            <p class="sell-intro">
              Fair market offers from a specialist who understands what your watch is actually worth. Not a pawn
              shop. Not an algorithm.
            </p>
            <div class="sell-steps">
              <div class="sell-step">
                <div class="sell-step-num">1</div>
                <div class="sell-step-body">
                  <strong>Submit Details</strong>
                  Brand, reference, condition, and what's included.
                </div>
              </div>
              <div class="sell-step">
                <div class="sell-step-num">2</div>
                <div class="sell-step-body">
                  <strong>Receive Offer</strong>
                  Direct response within 24 hours. No obligation.
                </div>
              </div>
              <div class="sell-step">
                <div class="sell-step-num">3</div>
                <div class="sell-step-body">
                  <strong>Get Paid</strong>
                  Local drop-off or insured mail-in. Fast payment.
                </div>
              </div>
            </div>
          </div>
          <div class="sell-right">
            <form data-netlify="true" name="sell-quote" method="POST" action="/sell/">
              <input type="hidden" name="form-name" value="sell-quote" />
              <div class="form-group">
                <label class="form-label-dark" for="sell-brand-home">Watch Brand</label>
                <select class="form-field-dark" id="sell-brand-home" name="brand" required>
                  <option value="">Select brand</option>
                  <option>Rolex</option>
                  <option>Omega</option>
                  <option>Seiko</option>
                  <option>Cartier</option>
                  <option>Tudor</option>
                  <option>Tag Heuer</option>
                  <option>Hamilton</option>
                  <option>Citizen</option>
                  <option>Other Luxury</option>
                  <option>Vintage</option>
                  <option>Other</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label-dark" for="sell-model-home">Model / Reference</label>
                <input
                  class="form-field-dark"
                  type="text"
                  id="sell-model-home"
                  name="model_reference"
                  placeholder="e.g. Submariner, Ref. 116610"
                  required
                />
              </div>
              <div class="form-group">
                <label class="form-label-dark" for="sell-condition-home">Condition</label>
                <select class="form-field-dark" id="sell-condition-home" name="condition" required>
                  <option value="">Select condition</option>
                  <option>Mint / Unworn</option>
                  <option>Excellent</option>
                  <option>Very Good</option>
                  <option>Good</option>
                  <option>Fair</option>
                  <option>Not Working</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label-dark" for="sell-box-home">Included with watch</label>
                <select class="form-field-dark" id="sell-box-home" name="included" required>
                  <option value="">Select</option>
                  <option>Full Box &amp; Papers</option>
                  <option>Box Only</option>
                  <option>Papers Only</option>
                  <option>No Box or Papers</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label-dark" for="sell-consign-home">Interested in consignment?</label>
                <select class="form-field-dark" id="sell-consign-home" name="consignment" required>
                  <option value="">Select</option>
                  <option>No, I want to sell outright</option>
                  <option>Yes, tell me about consignment</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label-dark" for="sell-name-home">Your Name</label>
                <input
                  class="form-field-dark"
                  type="text"
                  id="sell-name-home"
                  name="name"
                  placeholder="Full name"
                  required
                />
              </div>
              <div class="form-group">
                <label class="form-label-dark" for="sell-email-home">Email Address</label>
                <input
                  class="form-field-dark"
                  type="email"
                  id="sell-email-home"
                  name="email"
                  placeholder="your@email.com"
                  required
                />
              </div>
              <div class="form-group">
                <label class="form-label-dark" for="sell-phone-home">Phone</label>
                <input
                  class="form-field-dark"
                  type="tel"
                  id="sell-phone-home"
                  name="phone"
                  placeholder="Best number to reach you"
                  required
                />
              </div>
              <div class="form-group">
                <label class="form-label-dark" for="sell-notes-home">Additional notes</label>
                <textarea
                  class="form-field-dark form-field-dark--textarea"
                  id="sell-notes-home"
                  name="notes"
                  rows={4}
                ></textarea>
              </div>
              <button type="submit" class="sell-submit">Submit for Offer →</button>
              <p class="sell-note">No obligation. We respond within 24 hours.</p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section class="section-journal">
      <div class="container">
        <div class="section-hd">
          <h2 class="section-title">The Watch Journal</h2>
          <a href="/guide/" class="section-link">All articles →</a>
        </div>
        <div class="journal-grid">
          <a href="/guide/how-often-service-rolex/" class="journal-card">
            <div class="journal-img">
              <Image
                src={journalPhoto1}
                alt="Rolex watch service guide"
                width={600}
                height={300}
                loading="lazy"
                class="journal-photo"
              />
              <span class="journal-cat">Rolex</span>
            </div>
            <div class="journal-body">
              <h3 class="journal-title">How Often Should You Service a Rolex?</h3>
              <p class="journal-excerpt">
                Official intervals vs. what independent specialists recommend for real daily wear.
              </p>
              <span class="journal-link">Read article →</span>
            </div>
          </a>
          <a href="/guide/is-my-watch-worth-repairing/" class="journal-card">
            <div class="journal-img">
              <Image
                src={journalPhoto2}
                alt="Is my watch worth repairing guide"
                width={600}
                height={300}
                loading="lazy"
                class="journal-photo"
              />
              <span class="journal-cat">Decision Guide</span>
            </div>
            <div class="journal-body">
              <h3 class="journal-title">Is My Watch Worth Repairing?</h3>
              <p class="journal-excerpt">
                A practical framework using repair cost, watch value, and sentimental importance.
              </p>
              <span class="journal-link">Read article →</span>
            </div>
          </a>
          <a href="/guide/rolex-service-cost/" class="journal-card">
            <div class="journal-img">
              <Image
                src={journalPhoto3}
                alt="Rolex service cost guide"
                width={600}
                height={300}
                loading="lazy"
                class="journal-photo"
              />
              <span class="journal-cat">Pricing</span>
            </div>
            <div class="journal-body">
              <h3 class="journal-title">How Much Does a Rolex Service Cost?</h3>
              <p class="journal-excerpt">
                Authorized service vs. independent pricing — what to expect line by line.
              </p>
              <span class="journal-link">Read article →</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="section-process">
      <div class="container">
        <p class="process-hd">How it works</p>
        <div class="process-steps">
          <div class="process-step">
            <div class="process-icon">◷</div>
            <div class="process-step-num">Step 1</div>
            <div class="process-step-label">Find Your Watch</div>
            <div class="process-step-sub">Browse our curated pre-owned inventory</div>
          </div>
          <div class="process-arrow">→</div>
          <div class="process-step">
            <div class="process-icon">✉</div>
            <div class="process-step-num">Step 2</div>
            <div class="process-step-label">Send an Inquiry</div>
            <div class="process-step-sub">We respond personally within 24 hours</div>
          </div>
          <div class="process-arrow">→</div>
          <div class="process-step">
            <div class="process-icon">⊕</div>
            <div class="process-step-num">Step 3</div>
            <div class="process-step-label">Inspect in Person</div>
            <div class="process-step-sub">Local pickup or insured mail delivery</div>
          </div>
          <div class="process-arrow">→</div>
          <div class="process-step">
            <div class="process-icon">✓</div>
            <div class="process-step-num">Step 4</div>
            <div class="process-step-label">Enjoy Your Watch</div>
            <div class="process-step-sub">Every piece backed by our care and expertise</div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-stats">
      <div class="container">
        <div class="stats-hd">
          <h2 class="stats-title">Shelton Watch Services</h2>
          <p class="stats-sub">Serving the Lehigh Valley since 2012</p>
        </div>
        <div class="stats-grid">
          <div class="stat-item">
            <div class="stat-num">500<span class="stat-accent">+</span></div>
            <div class="stat-label">watches serviced across every brand and price point</div>
          </div>
          <div class="stat-item stat-divider">
            <div class="stat-num">12<span class="stat-accent">+</span></div>
            <div class="stat-label">years of independent watchmaking experience in the Lehigh Valley</div>
          </div>
          <div class="stat-item">
            <div class="stat-num">50<span class="stat-accent">+</span></div>
            <div class="stat-label">watch brands serviced from Casio to Rolex and everything between</div>
          </div>
        </div>
        <div class="stats-grid stats-grid-row2">
          <div class="stat-item">
            <div class="stat-num">4.9<span class="stat-accent">★</span></div>
            <div class="stat-label">average Google rating from verified customers</div>
          </div>
          <div class="stat-item stat-divider">
            <div class="stat-num"><span class="stat-accent">$</span>0</div>
            <div class="stat-label">cost for an estimate — no work begins without your written approval</div>
          </div>
          <div class="stat-item">
            <div class="stat-num">24<span class="stat-accent">hr</span></div>
            <div class="stat-label">response time on all sell quotes and service inquiries</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <InquiryModal />
  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 320px;
    background: var(--forest);
    display: grid;
    grid-template-columns: 55% 45%;
    overflow: hidden;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    grid-column: 1 / -1;
    grid-row: 1;
    background: linear-gradient(to right, #0d1f18 0%, var(--forest) 50%, transparent 100%);
    z-index: 2;
    pointer-events: none;
  }
  .hero-photo-col {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    overflow: hidden;
    align-self: stretch;
  }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .hero-photo-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--forest) 0%, rgba(30, 51, 40, 0.35) 100%);
    z-index: 1;
    pointer-events: none;
  }
  .hero-content {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    z-index: 3;
    align-self: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 40px 64px;
  }
  .eyebrow-hero {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 9px;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: var(--gold);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .eyebrow-hero::before {
    content: '';
    display: block;
    width: 20px;
    height: 1px;
    background: var(--gold);
    flex-shrink: 0;
  }
  .hero-h1 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(32px, 4vw, 58px);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fafaf5;
    margin-bottom: 16px;
  }
  .hero-h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--gold);
    text-transform: none;
  }
  .hero-sub {
    font-family: var(--ui);
    font-weight: 400;
    font-size: 13.5px;
    line-height: 1.75;
    color: rgba(245, 240, 232, 0.65);
    margin-bottom: 24px;
    max-width: 400px;
  }
  .hero-btns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn-ghost-light {
    background: none;
    color: rgba(245, 240, 232, 0.78);
    padding: 12px 26px;
    border: 0.5px solid rgba(245, 240, 232, 0.2);
    font-family: var(--ui);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-block;
    transition: all 0.2s;
  }
  .btn-ghost-light:hover {
    border-color: rgba(245, 240, 232, 0.5);
    color: #fafaf5;
  }
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .hero-photo-col {
      grid-column: 1;
      grid-row: 1;
      height: 300px;
    }
    .hero-content {
      grid-column: 1;
      grid-row: 2;
      align-self: stretch;
      padding: 48px 24px;
    }
    .hero-overlay {
      display: none;
    }
  }

  .section-watches {
    background: var(--ivory);
    padding: 56px 0;
  }
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 48px;
  }
  @media (max-width: 768px) {
    .container {
      padding: 0 24px;
    }
  }
  .section-hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 24px;
  }
  .section-title {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .section-link {
    font-family: var(--ui);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--gold);
    text-decoration: none;
    border-bottom: 1px solid rgba(197, 160, 40, 0.3);
    padding-bottom: 1px;
    transition: border-color 0.2s;
  }
  .section-link:hover {
    border-color: var(--gold);
  }
  .watch-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
  }
  @media (max-width: 960px) {
    .watch-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .watch-grid {
      grid-template-columns: 1fr;
    }
  }
  .watch-card {
    background: #fff;
    border: 0.5px solid var(--rule);
    text-decoration: none;
    color: inherit;
    display: block;
    transition: border-color 0.2s;
  }
  .watch-card:hover {
    border-color: rgba(197, 160, 40, 0.5);
  }
  .watch-card-img {
    width: 100%;
    height: 200px;
    background: var(--ivory2);
    position: relative;
    overflow: hidden;
  }
  .watch-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
    display: block;
  }
  .watch-card:hover .watch-photo {
    transform: scale(1.03);
  }
  .watch-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    font-family: var(--ui);
    font-weight: 500;
    font-size: 7.5px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    background: var(--forest);
    color: rgba(245, 240, 232, 0.88);
    padding: 3px 8px;
    z-index: 1;
  }
  .watch-card-info {
    padding: 14px 16px 16px;
  }
  .watch-brand {
    font-family: var(--ui);
    font-weight: 500;
    font-size: 8.5px;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 5px;
  }
  .watch-model {
    font-family: 'Cormorant SC', Georgia, serif;
    font-weight: 500;
    font-size: 17px;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin-bottom: 3px;
  }
  .watch-ref {
    font-family: var(--ui);
    font-weight: 400;
    font-size: 11px;
