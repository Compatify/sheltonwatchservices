---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteChrome from '../../components/SiteChrome.astro';
import WatchCard from '../../components/WatchCard.astro';
import { watchesByBrand } from '../../data/watches';
import { productSchemaForWatch } from '../../utils/productSchema';
import { jsonLd } from '../../utils/schema';

const title = 'Rolex Watches For Sale | Shelton Watch PA';
const description =
  'Shop pre-owned Rolex watches. Personally inspected, accurately described. Inquiry-based purchasing from a specialist watchmaker in Bethlehem PA.';
const list = watchesByBrand('Rolex');
const productGraph = { '@context': 'https://schema.org', '@graph': list.map(productSchemaForWatch) };
---

<BaseLayout {title} {description}>
  <script type="application/ld+json" slot="head" set:html={jsonLd(productGraph)} />
  <SiteChrome showInquiryModal>
    <main id="main">
      <article class="section section--ivory">
        <div class="container">
          <h1>Rolex Watches For Sale | Pre-Owned | Lehigh Valley PA</h1>
          <p class="muted">
            Pre-owned Rolex buying should feel grounded — reference clarity, bracelet honesty, and timing
            data you can trust. Inventory here is curated slowly, inspected like it might stay in the
            collection.
          </p>
          <p class="muted">
            Service support lives on the same bench: <a href="/service/rolex/">Rolex service</a> ·{' '}
            <a href="/sell/rolex/">Sell your Rolex</a> · <a href="/sell/">Other brands</a>
          </p>
          <div class="card-grid shop-grid">
            {list.map((w) => (
              <WatchCard watch={w} />
            ))}
          </div>
          <p class="muted note">
            Don’t see your reference? Ask via the <a href="/shop/">shop hub wishlist form</a>.
          </p>
        </div>
      </article>
    </main>
  </SiteChrome>
</BaseLayout>

<style>
  .shop-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 28px;
  }

  @media (max-width: 900px) {
    .shop-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .shop-grid {
      grid-template-columns: 1fr;
    }
  }

  a {
    color: var(--ink3);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a:hover {
    color: var(--gold);
  }

  .note {
    margin-top: 20px;
  }
</style>
