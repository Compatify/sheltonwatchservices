---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteChrome from '../../components/SiteChrome.astro';
import ServiceRequestForm from '../../components/ServiceRequestForm.astro';
import serviceImg from '../../assets/watches/photo-1606744188285-d0a49e58f538.jpeg';
import { localBusinessSchema } from '../../data/schema/localBusiness';
import { serviceSchema } from '../../utils/serviceSchema';
import { faqPageSchema } from '../../utils/faqSchema';
import { jsonLd } from '../../utils/schema';

const title = 'Watch Repair & Service | Shelton Watch | Bethlehem PA';
const description =
  'Expert watch repair in Lehigh Valley PA. Battery replacement from $25, full overhaul from $250. All brands. Free written estimate. Mail-in nationwide.';
const svc = serviceSchema(
  'Watch Repair and Servicing',
  'Independent watch service in Bethlehem PA with written estimates, mail-in nationwide support, and transparent pricing for battery, crystal, overhaul, and vintage work.',
);
const faqs = [
  {
    q: 'How long does a watch service take?',
    a: 'Timing depends on parts and complexity. Many battery and crystal jobs turn quickly; full mechanical services are quoted with realistic windows once evaluated — never a surprise finish date.',
  },
  {
    q: 'Do you service watches by mail?',
    a: 'Yes. Insured shipping nationwide is common. We confirm intake, document condition on arrival, and discuss approvals before ordering parts.',
  },
  {
    q: 'Do you offer a warranty on repairs?',
    a: 'Completed work is backed by a stated warranty period discussed at pickup — specifics depend on service type and parts used.',
  },
];
const faqLd = faqPageSchema(faqs);

const brandLogos = [
  { src: '/brands/rolex.svg', href: '/service/rolex/', label: 'Rolex service' },
  { src: '/brands/omega.svg', href: '/service/omega/', label: 'Omega service' },
  { src: '/brands/tudor.svg', href: '/service/tudor/', label: 'Tudor service' },
  { src: '/brands/seiko.svg', href: '/service/seiko/', label: 'Seiko service' },
  { src: '/brands/tagheuer.svg', href: '/service/tag-heuer/', label: 'TAG Heuer service' },
  { src: '/brands/cartier.svg', href: '/service/cartier/', label: 'Cartier service' },
];
---

<BaseLayout {title} {description}>
  <script type="application/ld+json" slot="head" set:html={jsonLd(localBusinessSchema)} />
  <script type="application/ld+json" slot="head" set:html={jsonLd(svc)} />
  <script type="application/ld+json" slot="head" set:html={jsonLd(faqLd)} />
  <SiteChrome>
    <main id="main">
      <article class="section section--ivory">
        <div class="container">
          <h1>Watch Service &amp; Repair</h1>
          <div class="service-hero-strip">
            <Image
              src={serviceImg}
              alt="Watch servicing and repair at the bench"
              width={1600}
              height={640}
              class="service-hero-img"
            />
            <div class="service-hero-strip-overlay"></div>
          </div>
          <div class="service-hero">
            <div>
              <p class="muted">
                Independent watchmaking for the Lehigh Valley — with the kind of estimates you can forward
                to your spouse without wincing. Whether you need a battery or a full overhaul, the process
                starts with diagnosis, not sales pressure.
              </p>
            </div>
            <aside class="callout">
              <p>
                Mail-in service nationwide · Local Bethlehem PA · Free written estimate · No work done
                without your approval
              </p>
            </aside>
          </div>
          <h2>Brands we service</h2>
          <p class="muted">
            Rolex · Omega · Seiko · Cartier · Tudor · TAG Heuer · Hamilton · Citizen · Bulova · Longines ·
            Waltham · Elgin — plus many more, including vintage wristwatches and American pocket watches.
          </p>

          <div class="brand-ticker-wrap" data-brand-ticker>
          <button
            type="button"
            class="brand-ticker-arrow brand-ticker-arrow--prev"
            data-brand-ticker-prev
            aria-label="Scroll brands backward"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
          <div class="brand-ticker-viewport">
            <div class="brand-ticker-track brand-ticker-track--css" data-brand-ticker-track>
              <ul class="brand-ticker-set">
                {
                  brandLogos.map((b) => (
                    <li class="brand-ticker-item">
                      <a class="brand-ticker-link" href={b.href} data-brand-ticker-logo>
                        <span class="brand-ticker-logo-cell">
                          <span class="brand-ticker-logo-vignette" aria-hidden="true"></span>
                          <img src={b.src} alt="" width="120" height="48" loading="lazy" decoding="async" />
                        </span>
                        <span class="brand-ticker-learn" aria-hidden="true">Learn More</span>
                        <span class="visually-hidden">{b.label}</span>
                      </a>
                    </li>
                  ))
                }
                <li class="brand-ticker-item">
                  <a class="brand-ticker-more" href="/service/" data-brand-ticker-logo>&amp; More</a>
                </li>
              </ul>
              <ul class="brand-ticker-set" aria-hidden="true">
                {
                  brandLogos.map((b) => (
                    <li class="brand-ticker-item">
                      <a class="brand-ticker-link" href={b.href} tabindex="-1" data-brand-ticker-logo>
                        <span class="brand-ticker-logo-cell">
                          <span class="brand-ticker-logo-vignette" aria-hidden="true"></span>
                          <img src={b.src} alt="" width="120" height="48" loading="lazy" decoding="async" />
                        </span>
                        <span class="brand-ticker-learn" aria-hidden="true">Learn More</span>
                        <span class="visually-hidden">{b.label}</span>
                      </a>
                    </li>
                  ))
                }
                <li class="brand-ticker-item">
                  <a class="brand-ticker-more" href="/service/" tabindex="-1" data-brand-ticker-logo>&amp; More</a>
                </li>
              </ul>
            </div>
          </div>
          <button
            type="button"
            class="brand-ticker-arrow brand-ticker-arrow--next"
            data-brand-ticker-next
            aria-label="Scroll brands forward"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
          </div>
        </div>

        <div class="container">
          <h2>Service types &amp; starting prices</h2>
          <ul class="price-list muted">
            <li>Battery replacement from $25</li>
            <li>Crystal replacement from $80</li>
            <li>Band / bracelet repair from $40</li>
            <li>Full overhaul from $250</li>
            <li>Vintage restoration from $350</li>
            <li>Watch appraisal from $50</li>
            <li>Polishing from $75</li>
            <li>Stem &amp; crown repair from $85</li>
          </ul>
          <h2>Request service</h2>
          <ServiceRequestForm idSuffix="-hub" />
          <h2>Frequently Asked Questions</h2>
          <dl class="faq-list">
            {faqs.map((f) => (
              <>
                <dt>{f.q}</dt>
                <dd>{f.a}</dd>
              </>
            ))}
          </dl>
          <p class="sell-cta muted">
            Also buying watches — <a href="/sell/">get a free quote</a> if you are considering selling or
            trading toward service.
          </p>
        </div>
      </article>
    </main>
  </SiteChrome>
</BaseLayout>

<script>
  (function () {
    const root = document.querySelector('[data-brand-ticker]');
    const track = document.querySelector('[data-brand-ticker-track]');
    const prevBtn = document.querySelector('[data-brand-ticker-prev]');
    const nextBtn = document.querySelector('[data-brand-ticker-next]');
    const logoLinks = document.querySelectorAll('[data-brand-ticker-logo]');
    if (!root || !track || !prevBtn || !nextBtn) return;

    const DURATION_MS = 52000;
    let anim = null;
    let touchActive = false;
    let lastTouchX = 0;

    function loopWidthPx() {
      return Math.max(1, track.scrollWidth / 2);
    }

    function startAnim() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        track.classList.add('brand-ticker-track--css');
        if (anim) {
          anim.cancel();
          anim = null;
        }
        return;
      }
      track.classList.remove('brand-ticker-track--css');
      if (anim) anim.cancel();
      anim = track.animate(
        [{ transform: 'translateX(0)' }, { transform: 'translateX(-50%)' }],
        {
          duration: DURATION_MS,
          iterations: Infinity,
          easing: 'linear',
        },
      );
    }

    function nudge(deltaPx) {
      if (!anim) return;
      const w = loopWidthPx();
      anim.pause();
      const t = anim.currentTime;
      const shift = (deltaPx / w) * DURATION_MS;
      anim.currentTime = Math.max(0, t + shift);
      anim.play();
    }

    function pauseAnim() {
      if (anim) anim.pause();
    }

    function playAnim() {
      if (anim && !touchActive) anim.play();
    }

    startAnim();
    window.addEventListener('resize', function () {
      startAnim();
    });

    prevBtn.addEventListener('click', function () {
      nudge(-140);
    });
    nextBtn.addEventListener('click', function () {
      nudge(140);
    });

    logoLinks.forEach(function (el) {
      el.addEventListener('mouseenter', pauseAnim);
      el.addEventListener('mouseleave', playAnim);
      el.addEventListener('focus', pauseAnim);
      el.addEventListener('blur', playAnim);
    });

    root.addEventListener(
      'touchstart',
      function (e) {
        if (e.touches.length !== 1) return;
        touchActive = true;
        lastTouchX = e.touches[0].clientX;
        pauseAnim();
      },
      { passive: true },
    );

    root.addEventListener(
      'touchmove',
      function (e) {
        if (!touchActive || e.touches.length !== 1 || !anim) return;
        const w = loopWidthPx();
        const x = e.touches[0].clientX;
        const dx = x - lastTouchX;
        lastTouchX = x;
        anim.pause();
        const t = anim.currentTime;
        const shift = (dx / w) * DURATION_MS;
        anim.currentTime = Math.max(0, t + shift);
      },
      { passive: true },
    );

    root.addEventListener(
      'touchend',
      function () {
        touchActive = false;
        playAnim();
      },
      { passive: true },
    );

    root.addEventListener(
      'touchcancel',
      function () {
        touchActive = false;
        playAnim();
      },
      { passive: true },
    );
  })();
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .service-hero-strip {
    position: relative;
    width: calc(100% + 96px);
    max-width: none;
    margin: 20px -48px 28px;
    height: 320px;
    overflow: hidden;
  }

  .service-hero-strip :global(.service-hero-img),
  .service-hero-strip :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .service-hero-strip-overlay {
    position: absolute;
    inset: 0;
    background: rgba(30, 51, 40, 0.45);
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .service-hero-strip {
      width: calc(100% + 48px);
      margin-left: -24px;
      margin-right: -24px;
      height: 260px;
    }
  }

  .service-hero {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 28px;
    align-items: start;
    margin: 24px 0 32px;
  }

  @media (max-width: 900px) {
    .service-hero {
      grid-template-columns: 1fr;
    }
  }

  .callout {
    background: var(--ivory2);
    border-left: 3px solid var(--gold);
    padding: 16px 20px;
    font-size: 14px;
    line-height: 1.75;
    color: var(--ink3);
  }

  /* —— Brand logo ticker —— */
  .brand-ticker-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 100%;
    margin: 8px 0 8px;
    padding: 22px 0 28px;
    box-sizing: border-box;
    border-top: 0.5px solid var(--rule-lt);
    border-bottom: 0.5px solid var(--rule-lt);
  }

  .brand-ticker-viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    touch-action: pan-x pinch-zoom;
  }

  .brand-ticker-track {
    display: flex;
    flex-direction: row;
    width: max-content;
    will-change: transform;
  }

  @keyframes brand-ticker-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .brand-ticker-track--css {
    animation: brand-ticker-marquee 52s linear infinite;
  }

  .brand-ticker-wrap:has(.brand-ticker-link:hover) .brand-ticker-track--css,
  .brand-ticker-wrap:has(.brand-ticker-more:hover) .brand-ticker-track--css,
  .brand-ticker-wrap:has(.brand-ticker-link:focus-visible) .brand-ticker-track--css,
  .brand-ticker-wrap:has(.brand-ticker-more:focus-visible) .brand-ticker-track--css {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-ticker-track--css {
      animation: none;
    }
  }

  .brand-ticker-set {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: clamp(28px, 4vw, 48px);
    flex-shrink: 0;
  }

  .brand-ticker-item {
    flex-shrink: 0;
  }

  .brand-ticker-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-decoration: none;
    color: inherit;
    min-height: 78px;
    padding: 2px 0 0;
  }

  .brand-ticker-logo-cell {
    position: relative;
    width: 118px;
    height: 50px;
    padding: 9px 10px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .brand-ticker-logo-vignette {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.38s cubic-bezier(0.22, 1, 0.36, 1);
    background: radial-gradient(
      ellipse 95% 90% at 50% 48%,
      rgba(30, 51, 40, 0) 35%,
      rgba(30, 51, 40, 0.14) 72%,
      rgba(20, 35, 28, 0.22) 100%
    );
    box-shadow: inset 0 0 0 0.5px rgba(30, 51, 40, 0.06);
  }

  .brand-ticker-link:hover .brand-ticker-logo-vignette,
  .brand-ticker-link:focus-visible .brand-ticker-logo-vignette {
    opacity: 1;
  }

  .brand-ticker-logo-cell img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transform: scale(1);
    transform-origin: center center;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .brand-ticker-link:hover .brand-ticker-logo-cell img,
  .brand-ticker-link:focus-visible .brand-ticker-logo-cell img {
    transform: scale(1.09);
  }

  .brand-ticker-learn {
    font-family: var(--sans);
    font-weight: 400;
    font-size: 8px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    margin-top: 10px;
    line-height: 1.2;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    white-space: nowrap;
  }

  .brand-ticker-link:hover .brand-ticker-learn,
  .brand-ticker-link:focus-visible .brand-ticker-learn {
    opacity: 1;
    transform: translateY(0);
  }

  .brand-ticker-more {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink3);
    text-decoration: none;
    white-space: nowrap;
    padding: 8px 4px;
    opacity: 1;
    transition: opacity 0.22s ease;
  }

  .brand-ticker-more:hover,
  .brand-ticker-more:focus-visible {
    opacity: 0.78;
  }

  .brand-ticker-arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0.5px solid rgba(197, 160, 40, 0.35);
    background: transparent;
    color: var(--gold);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease;
  }

  .brand-ticker-arrow:hover {
    border-color: var(--gold);
    color: var(--gold2);
    background: rgba(197, 160, 40, 0.06);
  }

  .brand-ticker-arrow:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  @media (max-width: 560px) {
    .brand-ticker-wrap {
      padding: 18px 0 22px;
      gap: 8px;
    }

    .brand-ticker-arrow {
      width: 36px;
      height: 36px;
    }

    .brand-ticker-set {
      gap: 28px;
    }
  }

  .price-list {
    list-style: none;
    margin-top: 12px;
  }

  .price-list li {
    padding: 8px 0;
    border-bottom: 0.5px solid var(--rule-lt);
  }

  h2 {
    font-family: var(--sans);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 400;
    margin: 32px 0 12px;
  }

  .faq-list dt {
    font-weight: 600;
    margin-top: 18px;
    color: var(--ink2);
  }

  .faq-list dd {
    margin: 8px 0 0;
    color: var(--ink3);
  }

  .sell-cta {
    margin-top: 28px;
  }

  .sell-cta a {
    color: var(--ink3);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sell-cta a:hover {
    color: var(--gold);
  }
</style>
