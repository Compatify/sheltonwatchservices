        <th>Service</th>
        <th>Starts around</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Standard appraisal appointment</td>
        <td>$50</td>
      </tr>
      <tr>
        <td>Multi-watch estate blocks</td>
        <td>Quoted by count</td>
      </tr>
      <tr>
        <td>Extended research / documentation</td>
        <td>Quoted if needed</td>
      </tr>
    </tbody>
  </table>
  <p class="cross muted">
    Unsure whether to fix or sell? Try the <a href="/tools/repair-or-sell/">repair or sell tool</a>.
  </p>
</ServiceTypePage>
