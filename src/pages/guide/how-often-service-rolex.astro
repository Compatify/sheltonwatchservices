const faqs = [
  {
    q: 'What does a Rolex service include?',
    a: 'A full service typically covers disassembly, cleaning, lubrication, reassembly, regulation, and testing — plus discussion of water resistance and cosmetic work before anything abrasive touches the case or bracelet.',
  },
  {
    q: 'How much does it cost to service a Rolex?',
    a: 'Authorized service commonly lands around roughly $800–$1,500+ depending on model and cosmetic scope, while many independents quote roughly $300–$700 for comparable mechanical work — always confirmed after evaluation, not guessed from a chart.',
  },
  {
    q: 'Can an independent watchmaker service my Rolex?',
