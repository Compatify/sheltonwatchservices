---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteChrome from '../../components/SiteChrome.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getGuideCoverBySlug } from '../../data/guideCovers';

const entries = await getCollection('journal');
const sorted = entries.sort((a, b) => {
  const ad = a.data.date ? a.data.date.getTime() : 0;
  const bd = b.data.date ? b.data.date.getTime() : 0;
  return bd - ad;
});

const articles = sorted.map((entry) => {
  const slug = entry.data.slug || entry.slug;
  const cover =
    typeof entry.data.coverPhoto === 'string' && entry.data.coverPhoto.trim() !== ''
      ? entry.data.coverPhoto
      : getGuideCoverBySlug(slug);
  return {
    slug,
    href: `/guide/${slug}/`,
    title: entry.data.h1 || entry.data.title,
    excerpt: entry.data.excerpt || '',
    category: entry.data.category || '',
    cover,
  };
});
---

<BaseLayout
  title="Watch Repair & Buying Guides | Shelton Watch Services"
  description="Practical watch guides from an independent Lehigh Valley watchmaker — service intervals, costs, troubleshooting, and when to repair vs. sell."
>
  <SiteChrome>
    <main id="main" class="section section--ivory">
      <div class="container guide-hub">
        <h1>The Watch Guide</h1>
        <p class="muted stack-sm">
          Straight answers to the questions owners actually ask — written to be useful on the bench and in
          search.
        </p>
        <div class="card-grid guide-hub-grid">
          {articles.map((a) =>
            a.cover ? (
              <GuideCard
                category={a.category}
                title={a.title}
                excerpt={a.excerpt}
                href={a.href}
                coverPhoto={a.cover}
              />
            ) : null,
          )}
        </div>
      </div>
    </main>
  </SiteChrome>
</BaseLayout>

<style>
  .guide-hub h1 {
    margin-bottom: 12px;
  }

  .guide-hub-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 36px;
    gap: 2px;
  }

  @media (max-width: 900px) {
    .guide-hub-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .guide-hub-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
