---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteChrome from '../../components/SiteChrome.astro';

const title = 'Page Not Found | Shelton Watch Services';
const description =
  "The page you're looking for doesn't exist. Browse our watch services, shop, or sell your watch.";
---

<BaseLayout title={title} description={description}>
  <SiteChrome>
    <main id="main" class="notfound">
      <section class="notfound-hero section section--forest">
        <div class="container notfound-inner">
          <p class="notfound-code">404</p>
          <h1 class="notfound-title">That page has stopped working.</h1>
          <p class="notfound-sub muted">
            The link may be outdated, or the page may have moved — much like a watch that needs a fresh
            mainspring.
          </p>
          <div class="notfound-actions">
            <a class="btn-secondary" href="/shop/">Browse Shop</a>
            <a class="btn-secondary" href="/service/">Book Service</a>
            <a class="btn-secondary" href="/sell/">Sell Your Watch</a>
          </div>
        </div>
      </section>
    </main>
  </SiteChrome>
</BaseLayout>

<style>
  .notfound-hero {
    min-height: calc(100vh - 96px);
    display: flex;
    align-items: center;
  }

  .notfound-inner {
    text-align: center;
    padding: 80px 0;
  }

  .notfound-code {
    font-family: var(--sans);
    font-size: clamp(72px, 14vw, 120px);
    font-weight: 400;
    color: rgba(250, 247, 242, 0.2);
    line-height: 1;
    margin-bottom: 12px;
  }

  .notfound-title {
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(32px, 4vw, 44px);
    color: rgba(245, 240, 232, 0.9);
    margin-bottom: 16px;
  }

  .notfound-sub {
    color: rgba(245, 240, 232, 0.65);
    max-width: 460px;
    margin: 0 auto 28px;
    font-size: 15px;
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
</style>
